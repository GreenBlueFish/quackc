// --- Min-tree / Max-tree (Req 9.5, 9.10) ---
test MinTree4Tb for MinTree4 {
    wave { x = [5, 2, 9, 7]; expect y = 2;  expect default; }
    wave { x = [6, 6, 6, 6]; expect y = 6;  expect default; }
    wave { x = [inf, 3, inf, 1]; expect y = 1;  expect default; }
    wave { x = [inf, inf, inf, inf]; expect y = inf;  expect default; }
}

test MaxTree4Tb for MaxTree4 {
    wave { x = [5, 2, 9, 7]; expect y = 9;  expect default; }
    wave { x = [0, 0, 0, 0]; expect y = 0;  expect default; }
    wave { x = [inf, 3, 4, 1]; expect y = inf;  expect default; }
}

// Parameterized tree at its default width N=2 (Req 9.5 requires N>=2).
test MinTreeTb for MinTree {
    wave { x = [5, 2]; expect y = 2;  expect default; }
    wave { x = [3, inf]; expect y = 3;  expect default; }
}
test MaxTreeTb for MaxTree {
    wave { x = [5, 2]; expect y = 5;  expect default; }
    wave { x = [3, inf]; expect y = inf;  expect default; }
}

// --- Sort2 compare-exchange (Req 9.6, 9.10) ---
test Sort2Tb for Sort2 {
    wave { a = 3; b = 5; expect lo = 3; expect hi = 5;  expect default; }
    wave { a = 5; b = 3; expect lo = 3; expect hi = 5;  expect default; }
    wave { a = 4; b = 4; expect lo = 4; expect hi = 4;  expect default; }
    wave { a = 2; b = inf; expect lo = 2; expect hi = inf;  expect default; }
    wave { a = inf; b = inf; expect lo = inf; expect hi = inf;  expect default; }
}

// --- Sorting networks built from Sort2 (Req 9.7, 9.10), via flat equivalents ---
test Sort2FlatTb for Sort2Flat {
    wave { x = [5, 3]; expect y = [3, 5];  expect default; }
    wave { x = [2, inf]; expect y = [2, inf];  expect default; }
}
test Sort3FlatTb for Sort3Flat {
    wave { x = [4, 1, 2]; expect y = [1, 2, 4];  expect default; }
    wave { x = [3, 3, 1]; expect y = [1, 3, 3];  expect default; }
    wave { x = [inf, 2, 5]; expect y = [2, 5, inf];  expect default; }
}
test Sort4FlatTb for Sort4Flat {
    wave { x = [5, 2, 9, 7]; expect y = [2, 5, 7, 9];  expect default; }
    wave { x = [3, 3, inf, 1]; expect y = [1, 3, 3, inf];  expect default; }
    wave { x = [6, 5, 4, 0]; expect y = [0, 4, 5, 6];  expect default; }
    wave { x = [inf, inf, inf, inf]; expect y = [inf, inf, inf, inf];  expect default; }
}

// --- Winner-take-all, strict and first-wins (Req 9.8, 9.10) ---
test Wta3StrictTb for Wta3Strict {
    wave { x = [5, 2, 9]; expect y = [inf, 2, inf];  expect default; }
    wave { x = [2, 2, 9]; expect y = [inf, inf, inf];  expect default; }
    wave { x = [3, 5, 1]; expect y = [inf, inf, 1];  expect default; }
    wave { x = [inf, inf, inf]; expect y = [inf, inf, inf];  expect default; }
}
test Wta3FirstTb for Wta3First {
    wave { x = [5, 2, 9]; expect y = [inf, 2, inf];  expect default; }
    wave { x = [2, 2, 9]; expect y = [2, inf, inf];  expect default; }
    wave { x = [5, 2, 2]; expect y = [inf, 2, inf];  expect default; }
    wave { x = [1, 1, 1]; expect y = [1, inf, inf];  expect default; }
    wave { x = [inf, inf, inf]; expect y = [inf, inf, inf];  expect default; }
}

// --- Coincidence detector within k ticks (Req 9.9, 9.10), default K=1 ---
test CoincidenceTb for Coincidence {
    wave { a = 3; b = 3; expect y = 3;  expect default; }
    wave { a = 3; b = 4; expect y = 4;  expect default; }
    wave { a = 4; b = 3; expect y = 4;  expect default; }
    wave { a = 3; b = 5; expect y = inf;  expect default; }
    wave { a = 3; b = inf; expect y = inf;  expect default; }
    wave { a = inf; b = inf; expect y = inf;  expect default; }
}
