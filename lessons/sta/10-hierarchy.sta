// Lesson 10 — instances and hierarchy.
// A compare-exchange block, and a 3-input sorter built from three instances of it.
// (Named CmpEx, not Sort2, because the standard library already defines Sort2.)
//
// IMPORTANT simulation note:
//   The test runner treats a sub-module `inst` as an OPAQUE pass-through boundary — it does not
//   re-simulate the instance body. So a `test` that binds to an instance-based module (like Sort3
//   below) will not produce meaningful outputs. Instance-based modules still COMPILE and EXPORT
//   correctly:
//       quackc build 10-hierarchy.sta --top Sort3 --out out
//       quackc emit-netlist 10-hierarchy.sta --top Sort3 --format dot
//   To TEST the same logic, bind the testbench to a flat, primitive-only module that inlines the
//   comparators (Sort3FlatDemo below). The standard library follows exactly this convention
//   (SortNet3 is the hierarchical API; Sort3FlatDemo is the testable twin).

module CmpEx (input time a, input time b, output time lo, output time hi) {
    lo = min(a, b);
    hi = max(a, b);
}

// Hierarchical 3-input sorter: the 3-comparator network (0,1) -> (0,2) -> (1,2).
// Build it and emit its netlist to SEE the three CmpEx instances; test the flat twin below.
module Sort3 (input time x[3], output time y[3]) {
    wire time a0; wire time a1;
    wire time b0; wire time b2;
    inst c0 = CmpEx (.a(x[0]), .b(x[1]), .lo(a0), .hi(a1));
    inst c1 = CmpEx (.a(a0),   .b(x[2]), .lo(b0), .hi(b2));
    inst c2 = CmpEx (.a(a1),   .b(b2),   .lo(y[1]), .hi(y[2]));
    y[0] = b0;
}

// Flat twin: the identical comparator mesh, inlined, so the interpreter can simulate it.
module Sort3FlatDemo (input time x[3], output time y[3]) {
    wire time a0; wire time a1;
    wire time b0; wire time b2;
    a0 = min(x[0], x[1]);
    a1 = max(x[0], x[1]);
    b0 = min(a0, x[2]);
    b2 = max(a0, x[2]);
    y[0] = b0;
    y[1] = min(a1, b2);
    y[2] = max(a1, b2);
}

// CmpEx is primitive-only, so it CAN be tested directly.
test CmpExTb for CmpEx {
    wave { a = 5; b = 3;   expect lo = 3; expect hi = 5;  expect default; }
    wave { a = 2; b = inf; expect lo = 2; expect hi = inf;  expect default; }
}

// Test the flat twin (same logic as the hierarchical Sort3).
test Sort3FlatDemoTb for Sort3FlatDemo {
    wave { x = [4, 1, 2];   expect y = [1, 2, 4];  expect default; }
    wave { x = [3, 3, 1];   expect y = [1, 3, 3];  expect default; }   // tie
    wave { x = [inf, 2, 5]; expect y = [2, 5, inf];  expect default; }
}
